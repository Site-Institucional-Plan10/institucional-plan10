{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/saude",
      "destination": "/solucoes/saude",
      "statusCode": 301
    },
    {
      "source": "/seguros",
      "destination": "/solucoes/protecao",
      "statusCode": 301
    },
    {
      "source": "/financas",
      "destination": "/solucoes/financeiras",
      "statusCode": 301
    },
    {
      "source": "/consorcios",
      "destination": "/solucoes/crescimento",
      "statusCode": 301
    },
    {
      "source": "/servicos-24h",
      "destination": "/solucoes/assistencia",
      "statusCode": 301
    },
    {
      "source": "/seguros/automovel",
      "destination": "/solucoes/protecao?abrir=veiculos-e-frotas%2Fautomoveis",
      "statusCode": 301
    },
    {
      "source": "/seguros/residencial",
      "destination": "/solucoes/protecao?abrir=patrimonio-e-alto-valor%2Fimovel-residencial",
      "statusCode": 301
    },
    {
      "source": "/seguros/vida",
      "destination": "/solucoes/protecao?abrir=vida%2Fvida",
      "statusCode": 301
    },
    {
      "source": "/seguros/empresarial",
      "destination": "/solucoes/protecao",
      "statusCode": 301
    },
    {
      "source": "/consorcio",
      "destination": "/solucoes/crescimento",
      "statusCode": 301
    },
    {
      "source": "/servicos",
      "destination": "/solucoes/assistencia",
      "statusCode": 301
    }
  ]
}
